{
  "name": "formauto-hub-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "next start -p 3020",
    "dev": "npm run dev:full",
    "dev:web": "cross-env NEXT_PUBLIC_API_BASE_URL=https://localhost:7039 NEXT_PUBLIC_SITE_URL=http://localhost:3020 NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3020/dashboard/nckh/callback next dev -p 3020",
    "dev:api": "dotnet run --project ../../src/FormAutoHub.Api/FormAutoHub.Api.csproj --launch-profile https",
    "dev:full": "concurrently --kill-others --names API,WEB --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "check:colors": "node scripts/check-color-tokens.mjs",
    "prebuild": "npm run check:colors",
    "build": "next build",
    "lint": "next lint"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "^15.5.18",
    "@xyflow/react": "^12.11.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "^15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.18",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
